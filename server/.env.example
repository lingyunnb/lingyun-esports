# 复制本文件为 server/.env 并修改（真实 .env 不入 git）
# 数据库/Redis 连接需与 infra/.env 一致
NODE_ENV=development
PORT=3000
CORS_ORIGINS=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fish_app
DB_PASSWORD=change-me-app-password
DB_NAME=fish_platform

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=change-me-redis-password

# 用 node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" 生成
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# 媒体文件存储根目录（D 盘数据规划：头像/背景图/商品图/视频/聊天图片）
MEDIA_ROOT=D:\fish\data\uploads

# 超级管理员种子账号（仅首次启动创建，幂等；首次启动前请改成强密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# AI 咨询「祁小山」（GLM OpenAI 兼容接口；key 仅存服务端，绝不入代码与客户端）
AI_PROVIDER=glm
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4-flash

# 邮箱验证（负责人 2026-10-05：用邮箱验证替代短信验证，0 成本）
# MAIL_PASS 填邮箱服务商的「SMTP 授权码」（QQ 邮箱：设置 → 账户 → 开启 IMAP/SMTP 服务后生成），
# 不是登录密码；仅存服务端 .env，绝不入库/入代码/入日志
MAIL_ENABLED=true
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=change-me@qq.com
MAIL_PASS=change-me-smtp-authorization-code
MAIL_FROM_NAME=祁连山电竞
# ⚠️ 必须与 MAIL_USER **完全一致**：QQ SMTP 强制要求信封发件人 = 认证账号，
#    否则报 501 Mail from address must be same as authorization user。
#    另注：QQ 个人邮箱的「英文别名」（如 xxx@qq.com 别名）**不能**用于 SMTP 认证，
#    MAIL_USER 必须填主账号（QQ 号@qq.com）。
MAIL_FROM=change-me@qq.com
MAIL_CODE_TTL_SECONDS=600
MAIL_CODE_RESEND_SECONDS=60
# 发信驱动：smtp=真发信（生产唯一允许值）；console=不发真信、验证码写日志（仅开发/自动化测试，生产禁用）
MAIL_DRIVER=smtp
# ⚠️ 以下两把"测试钥匙"生产必须保持 false（默认即 false）：
#   MAIL_ALLOW_CONSOLE=true 才允许在 NODE_ENV=production 下用 console 驱动（否则启动即报错拒绝启动）
#   MAIL_ALLOW_TEST_ENDPOINTS=true 才开放 /auth/email/_test/* 测试端点（生产必须 false）
MAIL_ALLOW_CONSOLE=false
MAIL_ALLOW_TEST_ENDPOINTS=false
# 同 IP 每小时取码上限（默认 10；测试可调小以免真发 10 封邮件）
MAIL_IP_HOURLY_LIMIT=10

# ── QQ 登录（负责人 2026-10-10：服务端接线；客户端由后续批次做）────────────────────────
# 在 QQ 互联（https://connect.qq.com）创建应用后拿到的 APP ID / APP Key。
# ⚠️ **两项任一为空 = 未配置** → POST /auth/qq/login 与 /auth/qq/bind 一律中文 503「QQ 登录未配置」，
#    且服务端**不做任何网络调用**（因此没拿到 APP ID/Key 时服务端可以先行上线）。
# ⚠️ QQ_APP_KEY 只存服务端 .env，**绝不入库/入代码/入日志/下发客户端**。
# 复核链路（服务端自己走，绝不相信客户端传的 openid）：
#   1) GET https://graph.qq.com/oauth2.0/me?access_token=…&fmt=json&unionid=1 → 权威 openid/unionid + client_id 校验；
#   2) GET https://graph.qq.com/user/get_user_info?… → 昵称（失败只降级为无昵称，不影响登录）。
#    两次调用均为 10s 硬超时（不卡死铁律），失败返回中文 400/503，绝不 500。
QQ_APP_ID=
QQ_APP_KEY=
# Graph API 基址（默认 https://graph.qq.com）。**仅供本地打桩/联调测试**，生产保持留空。
QQ_GRAPH_BASE_URL=
