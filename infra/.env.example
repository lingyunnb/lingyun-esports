# 复制本文件为 infra/.env 并修改全部密码（真实 .env 不入 git）
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=fish_platform
MYSQL_USER=fish_app
MYSQL_PASSWORD=change-me-app-password
MYSQL_PORT=3306
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6380

# 可选：数据根目录（默认 ../data = D:\fish\data，数据库/Redis 持久化位置，一般无需修改）
# DATA_DIR=../data
